<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:version="20131001">
  <uml:Model xmi:id="model" name="aether" visibility="public">
    <ownedComment xmi:type="uml:Comment" xmi:id="c_1">
      <body>UML 2.5 class diagram of the Aether shell (ports/aether) and of the Servo components this repository has changed: aether_history, constellation, embedder_traits, script, and profile. Servo types that were only extended (WebView, WebViewDelegate) stay in the external package. Packages follow the Rust modules. Traits are interfaces. Enums are enumerations. Modules with no types are utility classes. Composition means ownership. Shared aggregation means an Rc or a shared reference.</body>
    </ownedComment>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_aether" name="aether">
      <ownedComment xmi:type="uml:Comment" xmi:id="c_2">
        <body>ports/aether crate. Embedder entry point: desktop (winit/egui) or EGL (Android, OpenHarmony).</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_window" name="window">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_3">
          <body>Logical ServoShellWindow and the PlatformWindow abstraction.</body>
        </ownedComment>
        <packagedElement xmi:type="uml:DataType" xmi:id="win_ServoShellWindowId" name="ServoShellWindowId">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_85">
            <body>Monotonic shell window identifier.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_86" name="value" visibility="private" type="dt_8"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_87" name="next" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_88" name="return" direction="return" type="win_ServoShellWindowId"/>
          </ownedOperation>
        </packagedElement>
        <packagedElement xmi:type="uml:Interface" xmi:id="win_PlatformWindow" name="PlatformWindow">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_89">
            <body>Abstraction over windows: headed winit, headless, or embedded EGL.</body>
          </ownedComment>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_90" name="id" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_91" name="return" direction="return" type="win_ServoShellWindowId"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_92" name="screen_geometry" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_93" name="return" direction="return" type="dt_9"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_94" name="hidpi_scale_factor" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_95" name="return" direction="return" type="dt_10"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_96" name="rendering_context" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_97" name="return" direction="return" type="servo_RenderingContext"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_98" name="request_repaint" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_99" name="window" direction="in" type="win_ServoShellWindow"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_100" name="request_resize" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_101" name="webview" direction="in" type="servo_WebView"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_102" name="outerSize" direction="in" type="dt_11"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_103" name="return" direction="return" type="dt_11"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_104" name="update_user_interface_state" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_105" name="state" direction="in" type="state_RunningAppState"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_106" name="window" direction="in" type="win_ServoShellWindow"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_107" name="return" direction="return" type="dt_1"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_108" name="show_embedder_control" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_109" name="webviewId" direction="in" type="dt_12"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_110" name="control" direction="in" type="dt_13"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_111" name="theme" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_112" name="return" direction="return" type="dt_14"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_113" name="window_rect" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_114" name="return" direction="return" type="dt_15"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_115" name="has_platform_focus" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_116" name="return" direction="return" type="dt_1"/>
          </ownedOperation>
        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="win_TopLevelWebViewCreationRequest" name="TopLevelWebViewCreationRequest">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_117">
            <body>How to create a window's top-level WebView.</body>
          </ownedComment>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_118" name="WithUrl(Url)"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_119" name="WithCreateRequest(CreateNewWebViewRequest)"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="win_ServoShellWindow" name="ServoShellWindow">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_120">
            <body>Logical window: WebView collection, platform window, and pending interface commands.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_121" name="closeScheduled" visibility="private" type="dt_1"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_122" name="needsUpdate" visibility="private" type="dt_1"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_123" name="needsRepaint" visibility="private" type="dt_1"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_124" name="new" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_125" name="platformWindow" direction="in" type="win_PlatformWindow"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_126" name="return" direction="return" type="win_ServoShellWindow"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_127" name="id" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_128" name="return" direction="return" type="win_ServoShellWindowId"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_129" name="create_toplevel_webview" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_130" name="state" direction="in" type="state_RunningAppState"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_131" name="creation" direction="in" type="win_TopLevelWebViewCreationRequest"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_132" name="return" direction="return" type="servo_WebView"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_133" name="create_and_activate_toplevel_webview" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_134" name="state" direction="in" type="state_RunningAppState"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_135" name="creation" direction="in" type="win_TopLevelWebViewCreationRequest"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_136" name="return" direction="return" type="servo_WebView"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_137" name="repaint_webviews" visibility="package"/>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_state" name="running_app_state">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_4">
          <body>State shared by desktop and EGL: Servo, windows, WebDriver, history.</body>
        </ownedComment>
        <packagedElement xmi:type="uml:Class" xmi:id="state_WebViewCollection" name="WebViewCollection">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_138">
            <body>Top-level WebViews of a window, creation order, and the active view.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_139" name="hasSystemFocus" visibility="private" type="dt_1"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_140" name="add" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_141" name="webview" direction="in" type="servo_WebView"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_142" name="set_focused" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_143" name="focused" direction="in" type="dt_1"/>
          </ownedOperation>
        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="state_UserInterfaceCommand" name="UserInterfaceCommand">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_144">
            <body>Pending interface command, handled by the main loop.</body>
          </ownedComment>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_145" name="Go(String)"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_146" name="Back"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_147" name="Forward"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_148" name="Reload"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_149" name="ReloadAll"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_150" name="Home"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_151" name="NewWebView(TopLevelWebViewCreationRequest)"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_152" name="CloseWebView(WebViewId)"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_153" name="NewWindow(TopLevelWebViewCreationRequest)"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="state_ServoShellServoDelegate" name="ServoShellServoDelegate">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_154">
            <body>Shell Servo delegate: devtools, errors, console.</body>
          </ownedComment>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_155" name="notify_devtools_server_started" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_156" name="port" direction="in" type="dt_16"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_157" name="token" direction="in" type="dt_7"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_158" name="request_devtools_connection" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_159" name="request" direction="in" type="dt_17"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_160" name="notify_error" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_161" name="error" direction="in" type="dt_18"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_162" name="show_console_message" visibility="public">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_163" name="level" direction="in" type="dt_19"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_164" name="message" direction="in" type="dt_7"/>
          </ownedOperation>
          <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="ir_165" client="state_ServoShellServoDelegate" supplier="servo_ServoDelegate" contract="servo_ServoDelegate"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="state_RunningAppState" name="RunningAppState">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_166">
            <body>Single running state: Servo, windows, preferences, WebDriver, history, accessibility.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_167" name="achievedStableImage" visibility="package" type="dt_1"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_168" name="exitScheduled" visibility="private" type="dt_1"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_169" name="experimentalPreferencesEnabled" visibility="private" type="dt_1"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_170" name="accessibilityActive" visibility="private" type="dt_1"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_171" name="new" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_172" name="servo" direction="in" type="servo_Servo"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_173" name="preferences" direction="in" type="prefs_ServoShellPreferences"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_174" name="waker" direction="in" type="servo_EventLoopWaker"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_175" name="return" direction="return" type="state_RunningAppState"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_176" name="open_window" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_177" name="platformWindow" direction="in" type="win_PlatformWindow"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_178" name="creation" direction="in" type="win_TopLevelWebViewCreationRequest"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_179" name="return" direction="return" type="win_ServoShellWindow"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_180" name="windows" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_181" name="return" direction="return" type="dt_20"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_182" name="focused_window" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_183" name="return" direction="return" type="win_ServoShellWindow"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_184" name="set_window_has_focus" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_185" name="window" direction="in" type="win_ServoShellWindow"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_186" name="hasFocus" direction="in" type="dt_1"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_187" name="spin_event_loop" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_188" name="return" direction="return" type="dt_1"/>
          </ownedOperation>
          <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="ir_189" client="state_RunningAppState" supplier="servo_WebViewDelegate" contract="servo_WebViewDelegate"/>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_history" name="history">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_5">
          <body>Decides how a committed navigation updates the profile history.</body>
        </ownedComment>
        <packagedElement xmi:type="uml:Class" xmi:id="hist_ActiveEntry" name="ActiveEntry">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_190">
            <body>Active history entry of a tab.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_191" name="url" visibility="private" type="dt_21"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_192" name="visitDate" visibility="private" type="dt_22"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="hist_HistoryUpdate" name="HistoryUpdate">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_193">
            <body>Effect of a committed navigation on history.</body>
          </ownedComment>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_194" name="RecordVisit"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_195" name="ReplaceVisit"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="hist_History" name="History">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_196">
            <body>Rust module of free functions. history_update chooses RecordVisit or ReplaceVisit and returns the new ActiveEntry. open_history opens HistoryService.</body>
          </ownedComment>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_197" name="history_update" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_198" name="active" direction="in" type="hist_ActiveEntry"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_199" name="url" direction="in" type="dt_21"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_200" name="navigationType" direction="in" type="emb_NavigationType"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_201" name="return" direction="return" type="hist_HistoryUpdate"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_202" name="open_history" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_203" name="opts" direction="in" type="servo_Opts"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_204" name="return" direction="return" type="hist_HistoryService"/>
          </ownedOperation>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_home" name="home">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_6">
          <body>Homepage, new-window, and new-tab preferences (home.json).</body>
        </ownedComment>
        <packagedElement xmi:type="uml:Enumeration" xmi:id="home_NewWindowChoice" name="NewWindowChoice">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_205">
            <body>What a new window opens. Matches the Firefox Homepage and new windows menu.</body>
          </ownedComment>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_206" name="Home"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_207" name="Url"/>
          <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_208" name="Blank"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="home_HomeSettings" name="HomeSettings">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_209">
            <body>Profile home preferences, named like Firefox, stored in home.json.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_210" name="customUrl" visibility="public" type="dt_7"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_211" name="startupPage" visibility="private" type="dt_24"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_212" name="newTabsHome" visibility="private" type="dt_1"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_213" name="showSearch" visibility="public" type="dt_1"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_214" name="showLogo" visibility="public" type="dt_1"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_215" name="new_window_url" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_216" name="return" direction="return" type="dt_7"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_217" name="new_tab_url" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_218" name="return" direction="return" type="dt_7"/>
          </ownedOperation>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="home_InstalledHomeSettings" name="InstalledHomeSettings">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_219">
            <body>Process-wide copy installed at startup for servo:settings and new tabs.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_220" name="configDir" visibility="private" type="dt_25"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="home_Home" name="Home">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_221">
            <body>Rust module of free functions. install_home_settings remembers the settings. new_tab_url and new_window_url resolve them.</body>
          </ownedComment>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_222" name="install_home_settings" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_223" name="configDir" direction="in" type="dt_26"/>
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_224" name="settings" direction="in" type="home_HomeSettings"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_225" name="new_tab_url" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_226" name="return" direction="return" type="dt_21"/>
          </ownedOperation>
          <ownedOperation xmi:type="uml:Operation" xmi:id="op_227" name="new_window_url" visibility="package">
            <ownedParameter xmi:type="uml:Parameter" xmi:id="p_228" name="return" direction="return" type="dt_21"/>
          </ownedOperation>
        </packagedElement>
      </packagedElement>
      <packagedElement xmi:type="uml:Package" xmi:id="pkg_search" name="search">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_7">
          <body>Profile search engines (search.json).</body>
        </ownedComment>
        <packagedElement xmi:type="uml:Class" xmi:id="search_BuiltinEngine" name="BuiltinEngine">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_229">
            <body>Engine shipped with Aether. The user file refers to it by id.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_230" name="id" visibility="public" type="dt_7"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_231" name="name" visibility="public" type="dt_7"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_232" name="url" visibility="public" type="dt_7"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="search_SearchEngine" name="SearchEngine">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_233">
            <body>Configured engine, built-in or added. %s stands in for the query.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_234" name="id" visibility="public" type="dt_7"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_235" name="name" visibility="public" type="dt_7"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_236" name="url" visibility="public" type="dt_7"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_237" name="alias" visibility="public" type="dt_6"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_238" name="order" visibility="public" type="dt_27"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="attr_239" name="builtin" visibility="public" type="dt_1"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="search_SearchEngines" name="SearchEngines">
          <ownedComment xmi:type="uml:Comment" xmi:id="c_240">
