    <packagedElement xmi:type="uml:Dependency" xmi:id="dep_984" name="location bar" client="win_ServoShellWindow" supplier="parser_Parser"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="dep_985" name="reads" client="proto_ResourceProtocolHandler" supplier="res_Resources"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="dep_986" name="installs" client="cli_Cli" supplier="crash_CrashHandler"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="dep_987" name="installs" client="cli_Cli" supplier="panic_PanicHook"/>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_ahist" name="aether_history">
      <ownedComment xmi:type="uml:Comment" xmi:id="c_2100">
        <body>components/aether_history. Profile browsing history in a SQLite database (places and visits), written from a dedicated thread so the embedder never blocks on disk.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Class" xmi:id="hist_HistoryService" name="HistoryService">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_67">
          <body>Queues history commands on a channel and applies them on a thread named History. Dropping the service waits until pending commands are written.</body>
        </ownedComment>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2101" name="open" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2102" name="path" direction="in" type="dt_26"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2103" name="return" direction="return" type="hist_HistoryService"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2104" name="open_in_memory" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2105" name="return" direction="return" type="hist_HistoryService"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2106" name="record_visit" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2107" name="url" direction="in" type="dt_21"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2108" name="visitDate" direction="in" type="dt_22"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2109" name="title" direction="in" type="dt_6"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2110" name="set_title" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2111" name="url" direction="in" type="dt_21"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2112" name="title" direction="in" type="dt_7"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2113" name="replace_visit" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2114" name="oldUrl" direction="in" type="dt_21"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2115" name="visitDate" direction="in" type="dt_22"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2116" name="newUrl" direction="in" type="dt_21"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2117" name="title" direction="in" type="dt_6"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="ah_HistoryStore" name="HistoryStore">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2118">
          <body>SQLite connection. places stores each URL once (url, guid, title). visits stores one row per visit, dated in microseconds since the Unix epoch. Credentials are stripped before a URL is stored. Schema migrations are appended and tracked with user_version.</body>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr_2119" name="connection" visibility="private" type="dt_7"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2120" name="open" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2121" name="path" direction="in" type="dt_26"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2122" name="return" direction="return" type="ah_HistoryStore"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2123" name="open_in_memory" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2124" name="return" direction="return" type="ah_HistoryStore"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2125" name="apply" visibility="package">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2126" name="commands" direction="in" type="ah_HistoryCommand"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Enumeration" xmi:id="ah_HistoryCommand" name="HistoryCommand">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2127">
          <body>One change sent to the history thread. Several commands are applied together in a single transaction.</body>
        </ownedComment>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2128" name="RecordVisit"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2129" name="SetTitle"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2130" name="ReplaceVisit"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_embedder" name="embedder">
      <ownedComment xmi:type="uml:Comment" xmi:id="c_2131">
        <body>components/shared/embedder. Only the type Aether added for committed navigations is modeled here.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Enumeration" xmi:id="emb_NavigationType" name="NavigationType">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2132">
          <body>How the active session-history entry of a WebView changed when a navigation was committed.</body>
        </ownedComment>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2133" name="Push"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2134" name="Replace"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2135" name="Traverse"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_constellation" name="constellation">
      <ownedComment xmi:type="uml:Comment" xmi:id="c_2136">
        <body>components/constellation, limited to the types Aether changed for profile history and page titles. The rest of the constellation is unchanged Servo and is not drawn.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Class" xmi:id="co_Constellation" name="Constellation">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2137">
          <body>Multiprocess browser core. Records the navigation type on each pending session-history change and forwards the active top-level title to the embedder.</body>
        </ownedComment>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2138" name="handle_title_changed_msg" visibility="private">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2139" name="pipelineId" direction="in" type="dt_12"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2140" name="title" direction="in" type="dt_7"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2141" name="notify_history_changed" visibility="private">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2142" name="webviewId" direction="in" type="dt_12"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2143" name="navigationType" direction="in" type="emb_NavigationType"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="co_ConstellationWebView" name="ConstellationWebView">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2144">
          <body>Constellation state of one embedder WebView, including its joint session history and pending changes.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="co_JointSessionHistory" name="JointSessionHistory">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2145">
          <body>Joint session history of a WebView. Inner-frame URLs are projected to the parent URL when the embedder is notified.</body>
        </ownedComment>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="co_SessionHistoryChange" name="SessionHistoryChange">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2146">
          <body>Pending session-history change, applied once the new pipeline has loaded. Aether added navigationType, reported to the embedder when the new document becomes active.</body>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr_2147" name="browsingContextId" visibility="public" type="dt_12"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr_2148" name="webviewId" visibility="public" type="dt_12"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr_2149" name="newPipelineId" visibility="public" type="dt_12"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr_2150" name="navigationType" visibility="public" type="emb_NavigationType"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Enumeration" xmi:id="co_NeedsToReload" name="NeedsToReload">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2151">
          <body>Pipeline replaced by a session-history change: still alive, or discarded and reloaded from LoadData.</body>
        </ownedComment>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2152" name="No"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2153" name="Yes"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="co_Pipeline" name="Pipeline">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2154">
          <body>Constellation view of one window. Holds the document title. page_title is sent to the embedder only for the active top-level pipeline.</body>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr_2155" name="title" visibility="public" type="dt_7"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="attr_2156" name="webviewId" visibility="public" type="dt_12"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2157" name="page_title" visibility="package">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="p_2158" name="return" direction="return" type="dt_6"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Enumeration" xmi:id="co_ConstellationToEmbedderMsg" name="ConstellationToEmbedderMsg">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2159">
          <body>Messages from the constellation to the embedder. Only the variants Aether extended are listed: HistoryChanged now carries an optional NavigationType and page title, and PageTitleChanged reports the active top-level title.</body>
        </ownedComment>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2160" name="HistoryChanged"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="lit_2161" name="PageTitleChanged"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_script" name="script">
      <ownedComment xmi:type="uml:Comment" xmi:id="c_2162">
        <body>components/script, limited to the types Aether changed: document titles sent to the constellation, location navigations, and script-thread stats for the processes page.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Class" xmi:id="sc_Document" name="Document">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2163">
          <body>DOM document. When its title changes, it sends TitleChanged to the constellation with the pipeline id and the new title.</body>
        </ownedComment>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2164" name="title_changed" visibility="package"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="sc_Location" name="Location">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2165">
          <body>Window location. Navigations choose push, replace, or auto history handling. Client-side redirects and location.replace use replace, so they do not add a profile-history visit.</body>
        </ownedComment>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2166" name="navigate_a_location" visibility="private"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="sc_ScriptThread" name="ScriptThread">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2167">
          <body>Script event loop. Periodically publishes ScriptTabStats for the top-level document of this thread, used by the servo:processes page.</body>
        </ownedComment>
        <ownedOperation xmi:type="uml:Operation" xmi:id="op_2168" name="publish_tab_stats" visibility="private"/>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_profile" name="profile">
      <ownedComment xmi:type="uml:Comment" xmi:id="c_2169">
        <body>components/shared/profile. Aether added cross-process snapshots of script threads, written as JSON under the temporary directory.</body>
      </ownedComment>
      <packagedElement xmi:type="uml:Class" xmi:id="pr_ScriptTabStats" name="ScriptTabStats">
        <ownedComment xmi:type="uml:Comment" xmi:id="c_2170">
